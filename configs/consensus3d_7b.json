{
  "model_name": "Consensus3D",
  "configuration_role": "Manuscript reference architecture and training settings",
  "architecture": {
    "language_backbone_size": "7B",
    "language_checkpoint": "lmsys/vicuna-7b-v1.5",
    "language_hidden_size": 4096,
    "geometry_encoder": "Uni3D",
    "appearance_encoder": "DINOv2",
    "proposal_model": "Mask3D",
    "geometry_feature_size": 1024,
    "appearance_feature_size": 1024,
    "max_objects": 100,
    "visual_encoders_frozen": true,
    "independent_modality_projectors": true,
    "normalize_object_features": true,
    "activation": "GELU",
    "object_token_order": ["identifier", "geometry", "appearance"],
    "inference_representation": "distribution_mean",
    "log_variance_head_weight_init": 0.0,
    "log_variance_head_bias_init": -4.5,
    "log_variance_forward_offset": -4.5,
    "log_variance_upper_bound": -1.5,
    "additional_scene_description_supervision": false
  },
  "fine_tuning": {
    "language_transformer_frozen": true,
    "lora_rank": 16,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "lora_targets": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "input_embedding_matrix_trainable": true,
    "language_output_head_trainable": true,
    "detach_original_vocabulary_input_activations": true,
    "detach_system_prompt_input_activations": true,
    "retain_object_identifier_input_gradients": true,
    "gradient_checkpointing": true,
    "gradient_checkpointing_use_reentrant": false
  },
  "training": {
    "gpu_type": "NVIDIA RTX 4090",
    "gpu_count": 2,
    "samples_per_gpu": 16,
    "global_batch_size": 32,
    "gradient_accumulation": 1,
    "evaluation_samples_per_gpu": 16,
    "epochs": 2,
    "optimizer": "AdamW",
    "learning_rate_argument": 0.000005,
    "learning_rate_scaling": "argument times global batch size",
    "effective_base_learning_rate": 0.00016,
    "betas": [0.9, 0.999],
    "weight_decay": 0.02,
    "max_gradient_norm": 0.01,
    "learning_rate_schedule": "cosine",
    "learning_rate_warmup_epochs": 0.1,
    "minimum_learning_rate_multiplier": 0.01,
    "deterministic_dop_warmup_steps": 2000,
    "auxiliary_loss_ramp_steps": 1000,
    "maximum_kl_weight": 0.000001,
    "maximum_cmc_weight": 0.02,
    "cmc_temperature": 0.07,
    "cmc_negative_pool": "global_valid_objects",
    "kl_reduction": "sum latent dimensions; average valid objects and both modalities",
    "seed": 42,
    "maximum_generated_tokens": 64,
    "training_tasks": ["scanrefer", "scan2cap", "scanqa", "sqa3d", "multi3dref", "nr3d_caption", "obj_align"],
    "evaluation_tasks": ["scanrefer", "scan2cap", "scanqa", "sqa3d", "multi3dref"]
  }
}

